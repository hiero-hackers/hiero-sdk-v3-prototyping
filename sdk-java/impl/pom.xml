<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.hiero.sdk</groupId>
    <artifactId>hiero-sdk</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Hiero SDK</name>
    <description>The Java API of the Hiero SDK.</description>

    <modules>
        <module>org.hiero.base</module>
        <module>org.hiero.consensus.node.admin.client</module>
        <module>org.hiero.consensus.node.client</module>
        <module>org.hiero.enterprise</module>
        <module>org.hiero.mirror.node.client</module>
        <!-- the results of all tests as one HTML page (after the modules; with the profile tck after the TCK run) -->
        <module>test-report</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jspecify.version>1.0.0</jspecify.version>
        <junit.version>6.0.3</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>${jspecify.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                            <arg>-Werror</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.3</version>
                    <configuration>
                        <properties>
                            <configurationParameters>
                                junit.platform.reporting.open.xml.enabled = true
                                junit.platform.reporting.open.xml.git.enabled = true
                                junit.platform.output.capture.stdout = true
                                junit.platform.output.capture.stderr = true
                                junit.jupiter.extensions.autodetection.enabled = true
                                junit.platform.reporting.output.dir = ${project.build.directory}/surefire-reports
                            </configurationParameters>
                        </properties>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                    <configuration>
                        <doclint>all,-missing</doclint>
                        <failOnWarnings>true</failOnWarnings>
                        <quiet>true</quiet>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.6.4</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          While the module test-report renders the results (the default; -DtestReport.skip=true leaves it out), a failed
          test does not stop the build: every module is tested, the TCK runs with the profile tck, and the page shows
          all results. test-report fails the build at the end instead if a unit test failed
          (-DtestReport.failOnFailures=false: it does not). -Dmaven.test.failure.ignore=false stops at the first module
          again.
        -->
        <profile>
            <id>test-report</id>
            <activation>
                <property>
                    <name>!testReport.skip</name>
                </property>
            </activation>
            <properties>
                <maven.test.failure.ignore>true</maven.test.failure.ignore>
            </properties>
        </profile>
        <!--
          ./mvnw -f impl verify -Ptck: builds the TCK server in this reactor - the contract and the server generated
          from tooling/tck/bindings (sdk-java/tck/generated, regenerated first by scripts/tck-java.sh with the option
          generate-only; -Dtck.skipGenerate=true: not) and the hand-written runtime (sdk-java/tck/runtime) - against
          the modules of this build, and runs the Hiero TCK with it in the phase integration-test (module tck-run; a
          local Solo network must be running). The module test-report then puts its results on the page of all test
          results, sdk-java/impl/target/test-report/index.html. Properties of the module tck-run: tck.dir,
          tck.ignoreFailures, tck.tests.
        -->
        <profile>
            <id>tck</id>
            <properties>
                <tck.skipGenerate>false</tck.skipGenerate>
            </properties>
            <modules>
                <module>../tck/generated/contract</module>
                <module>../tck/runtime</module>
                <module>../tck/generated/server</module>
                <module>tck-run</module>
            </modules>
            <build>
                <plugins>
                    <!--
                      In the reactor's first project, before the TCK modules compile: their sources are regenerated in
                      place. The reactor has read their POMs already - a change of a generated POM takes effect with
                      the next build.
                    -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>tck-generate</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${tck.skipGenerate}</skip>
                                    <executable>bash</executable>
                                    <commandlineArgs>${project.basedir}/../../scripts/tck-java.sh --generate-only</commandlineArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
