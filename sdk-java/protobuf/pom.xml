<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.hiero.sdk</groupId>
    <artifactId>hiero-sdk-protobuf</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <name>Hiero SDK: protobuf (internal)</name>
    <description>
        The protobuf messages of the Hiero node types, compiled from the vendored definitions in
        /protobuf into the JPMS module org.hiero.sdk.protobuf.

        This module is an implementation detail of the SDK, not part of its public API: every package
        is exported only to the SDK modules that need it (see src/main/java/module-info.java). The
        module has no sources of its own - the .proto files live in /protobuf and the Java classes
        are build output.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <protobuf.version>4.31.1</protobuf.version>
        <protobuf.root>${project.basedir}/../../protobuf</protobuf.root>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <protocVersion>${protobuf.version}</protocVersion>
                    <sourceDirectories>
                        <!-- the base: every other node type imports from it -->
                        <sourceDirectory>${protobuf.root}/consensus-node</sourceDirectory>
                        <!-- the mirror node's gRPC API -->
                        <sourceDirectory>${protobuf.root}/mirror-node</sourceDirectory>
                    </sourceDirectories>
                    <excludes>
                        <!--
                            consensus-node/mirror/mirror_network_service.proto declares the same Java
                            package, message and service as mirror-node/.../network_service.proto (see
                            protobuf/README.md, "Findings"). Compiling both would produce duplicate
                            classes; the mirror node's own copy wins. Nothing imports consensus-node/mirror.
                        -->
                        <exclude>mirror/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
