<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written support types of the Java SDK (the @ThreadSafe annotation and the streaming types). The modules of
     the API generated from the specs (generated/java) depend on it instead of containing copies. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.hiero.sdk</groupId>
    <artifactId>hiero-sdk-support</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <name>Hiero SDK: support</name>
    <description>Support types of the Hiero SDK: the @ThreadSafe annotation and the streaming types.</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
