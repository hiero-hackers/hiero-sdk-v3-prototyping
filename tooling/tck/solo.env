# TCK configuration for a local Solo network (Solo 0.63+, `solo one-shot single deploy`). tck/run-tck.sh copies it as
# .env into the TCK clone and exports it for the TCK server. The values are the defaults of Solo
# (https://solo.hiero.org/docs/using-solo/endpoints/); the operator is Solo's default operator account with Solo's
# well-known development key — never use it for anything but a local network.

# The operator account (Solo: 0.0.2 with the default operator key)
OPERATOR_ACCOUNT_ID=0.0.2
OPERATOR_ACCOUNT_PRIVATE_KEY=302e020100300506032b65700422042091132178e72057a1d7528025956fe39b0b847f200ab59b2fdd367017f3087137

# The consensus node (Solo forwards its gRPC port to 35211)
NODE_IP=127.0.0.1:35211
NODE_ACCOUNT_ID=0.0.3
NODE_TIMEOUT=30000

# The mirror node REST API (Solo forwards it to 38081); also used by the V3 TCK runtimes
MIRROR_NODE_REST_URL=http://127.0.0.1:38081
# Not verified for Solo yet: the Java REST API of the mirror node (served behind the same ingress)
MIRROR_NODE_REST_JAVA_URL=http://127.0.0.1:38081
# Not verified for Solo yet: the gRPC API of the mirror node (not used by the V3 TCK runtimes)
MIRROR_NETWORK=127.0.0.1:5600

# The JSON-RPC server of the SDK under test (the generated TCK server)
JSON_RPC_SERVER_URL=http://localhost:8544/
