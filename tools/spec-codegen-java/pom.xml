<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.hiero.sdk.v3</groupId>
    <artifactId>hiero-sdk-v3-java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>spec-codegen-java</artifactId>
  <name>Hiero SDK V3 Specification Code Generator</name>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>validate-java-base-api</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>validate-java-base-specifications</id>
                <phase>verify</phase>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>org.hiero.sdk.v3.codegen.cli.Main</mainClass>
                  <arguments>
                    <argument>validate</argument>
                    <argument>--repository-root</argument>
                    <argument>${maven.multiModuleProjectDirectory}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>generate-java-base-api</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <executions>
              <execution>
                <id>compile-generator-before-generation</id>
                <phase>generate-sources</phase>
                <goals><goal>compile</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>generate-java-base-sources</id>
                <phase>generate-sources</phase>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>org.hiero.sdk.v3.codegen.cli.Main</mainClass>
                  <arguments>
                    <argument>generate</argument>
                    <argument>--repository-root</argument>
                    <argument>${maven.multiModuleProjectDirectory}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>clean-regenerate-java-base-api</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <executions>
              <execution>
                <id>compile-generator-before-clean-regeneration</id>
                <phase>generate-sources</phase>
                <goals><goal>compile</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>clean-regenerate-java-base-sources</id>
                <phase>generate-sources</phase>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>org.hiero.sdk.v3.codegen.cli.Main</mainClass>
                  <arguments>
                    <argument>generate</argument>
                    <argument>--repository-root</argument>
                    <argument>${maven.multiModuleProjectDirectory}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
